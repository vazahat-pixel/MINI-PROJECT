<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>USER AUTH</title>
        <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4/tailwind.min.css">
</head>
<body  class="bg-black text-white">
    <div class="gap-3 h-30 py-4 px-3 mt-15 ml-20 rounded-md border-1 outline-none" >
       <form class="px-2 py-3 outline-none rounded-md" action="/register" method="post">
        <input type="text" name="name" placeholder="Enter your name" class="px-2 py-1 border-1 rounded-md">
        <input type="text" name="username" placeholder="Enter your username"class="px-2 py-1 border-1 rounded-md">
        <input type="email" name="email" placeholder="Enter your email"class="px-2 py-1 border-1 rounded-md">
        <input type="password" name="password" placeholder="Enter your password"class="px-2 py-1 border-1 rounded-md">
        <input type="text" name="age" placeholder="Enter your age"class="px-2 py-1 border-1 rounded-md">
       
        <button type="submit"class="px-2 py-1 border-1 rounded-md">Register</button>
    
    </div>
</body>
</html>