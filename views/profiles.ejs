<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
       <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
       <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4/tailwind.min.css">

</head>
<body>
<div>
    <div class="text-red-500 flex justify-end text-2xl" > 
      <a class="bg-black-500" href="/logout">Logout</a>
    </div>
    <div>
        <h1 class="text-3xl">Welcome to your profile  <%= user.name %></h1>
        <h5 class="px-2 py-3 md-4">You can create a post</h5>
       <div>
        <form action="/post" method="post">
        <textarea class="w-1/2 border-2 rounded-md md-4 px-3 py-3" name="content" placeholder="Enter your content"></textarea>
        <input type="submit" class="block rounded-md px-3 py-2 bg-blue-500 outline-none"></input>
       </form>
    </div>

       <div>
        <h1 class="text-3xl">Your posts</h1>

        <div class="posts flex py-3 direction-coloum">
            <div class="posts">
                <div class="post w-1/3 p-4 bg-white text-black rounded-md px-3 py-3">
                <h4 class="text-blue-500">{post.title}</h4>
                <p class="text-sm ">Lorem ipsum dolor sit, amet consectetur adipisicing elit. Obcaecati a sed ea non sunt rerum, quisquam porro magni architecto omnis, ullam recusandae, vero deleniti officia repudiandae debitis suscipit laboriosam qui?</p>            
                <div class="btns flex gap-5">
                    <a class="text-blue-500 gap-2"  href="">Like</a>
                    <a class="text-zinc-500 gap-2"  href="">Edit</a>
                </div>
                </div>
            </div>
       </div>

    </div>
</div>
</body>
</html>